        "source_locator_ref"
      ],
      "properties": {
        "kind": {
          "const": "HSKRawFieldCapture"
        },
        "field_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "raw_value": {},
        "raw_value_status": {
          "enum": [
            "PRESERVED",
            "PRIVATE_ARCHIVE_ONLY",
            "UNKNOWN_PRESERVED",
            "MISSING",
            "SYNTHETIC_ONLY"
          ]
        },
        "normalized_value": {},
        "parser_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parser_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parse_status": {
          "enum": [
            "PARSED_CANDIDATE",
            "NOT_ATTEMPTED",
            "UNPARSED",
            "AMBIGUOUS",
            "ERROR",
            "HOLD"
          ]
        },
        "raw_field_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_locator_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "parse_status": {
                "not": {
                  "const": "PARSED_CANDIDATE"
                }
              }
            }
          },
          "then": {
            "properties": {
              "normalized_value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
