  "claims": [
    {
      "id": "H01.04.01.R1.C01",
      "owner": "H01",
      "topic": "H01.04.01",
      "rule": "tone_pair",
      "source": "H01-R1-EDUHK",
      "locator": "§3.2 a, lines 64–74",
      "statement": "同一语流域内相邻两个三声音节的常见变调使首个音节表层读作近似二声；须区分本调与表层调。",
      "conditions": [
        "明确 THIRD_TONE_PAIR_ONLY、同一语流域、本调类别、恰好两个音节；未知或不支持的范围返回 HOLD。"
      ],
      "negative": "不得由表层二声反推本调；三音节以上、边界及实际音高另核。"
    },
    {
      "id": "H01.04.02.R1.C01",
      "owner": "H01",
      "topic": "H01.04.02",
      "rule": "bu_tone",
      "source": "H01-R1-EDUHK",
      "locator": "§3.2 b, lines 81–85",
      "statement": "普通否定“不”在四声前常读二声，在一、二、三声前读四声；中间轻声结构须另分。",
      "conditions": [
        "只适用于明确给出的分析框架、证据及输入条件；未核实条件返回HOLD。"
      ],
      "negative": "不适用于所有不字、结果补语或缺语境表层形式。"
    },
    {
      "id": "H01.02.01.R1.C01",
      "owner": "H01",
      "topic": "H01.02.01",
      "rule": "initial_spelling",
      "source": "H01-R1-EDUHK",
      "locator": "Syllable, lines 9–15",
      "statement": "普通话拼音声母中 zh、ch、sh 等二字母写法在声母槽内各表示一个声母，而非两个相邻辅音。",
      "conditions": [
        "只适用于明确给出的分析框架、证据及输入条件；未核实条件返回HOLD。"
      ],
      "negative": "拼音拼写单位不等同实际音素串；不得对任意字母序列自动切分。"
    },
    {
      "id": "H01.03.02.R1.C01",
      "owner": "H01",
      "topic": "H01.03.02",
      "rule": "tone_value",
      "source": "H01-R1-LMU",
      "locator": "Tone in Mandarin, lines 4–7",
      "statement": "五度标记以相对音高层级描述轮廓；它是简化转写，不是说话人实际基频的 Hz 值。",
      "conditions": [
        "只适用于明确给出的分析框架、证据及输入条件；未核实条件返回HOLD。"
      ],
      "negative": "不能将相对层级换算成绝对Hz或直接以轮廓决定词汇调类。"
    },
    {
      "id": "H02.01.01.R1.C01",
      "owner": "H02",
      "topic": "H02.01.01",
      "rule": "glyph_identity",
      "source": "H02-R1-U17",
      "locator": "§18.1 Han / abstract shape",
      "statement": "Unicode 标识抽象编码字符，显示字形由字形选择与规范影响；码点一致仅能建立编码标识一致。",
      "conditions": [
        "只适用于明确给出的分析框架、证据及输入条件；未核实条件返回HOLD。"
      ],
      "negative": "不因视觉相似合并码点，也不凭同码点推断相同书写规范、读音或义项。"
    },
    {
      "id": "H02.01.02.R1.C01",
      "owner": "H02",
      "topic": "H02.01.02",
      "rule": "variant_context",
      "source": "H02-R1-UAX38",
      "locator": "§3.7.1 contextual conversion",
      "statement": "简转繁的一对多映射需要语义环境；以脏为例，内脏语义和肮脏语义的繁体候选不同。",
      "conditions": [
        "只适用于明确给出的分析框架、证据及输入条件；未核实条件返回HOLD。"
      ],
      "negative": "例子仅限该来源所述映射；不能推断所有词可逆或官方字形。"
    },
    {
      "id": "H02.02.01.R1.C01",
      "owner": "H02",
      "topic": "H02.02.01",
      "rule": "stroke_source",
      "source": "H02-R1-UAX38",
      "locator": "property kTotalStrokes / kAlternateTotalStrokes",
      "statement": "Unihan kTotalStrokes 按 IRG 笔画计数约定记录；本有限视图仅校验 UAX38 rev41 属性版本及 1–999 的整数表示范围，不核查真实字项。",
      "conditions": [
        "指定 UAX38_41、kTotalStrokes、同一字形规范、已给定合成整数值；缺一返回 HOLD。"
      ],
      "negative": "表示范围不等于实际汉字可能笔画数；不推断具体字的笔画数、规范字形或学习评价。"
    },
    {
      "id": "H02.03.01.R1.C01",
      "owner": "H02",
      "topic": "H02.03.01",
      "rule": "mandarin_property",
      "source": "H02-R1-UAX38",
      "locator": "property kMandarin",
      "statement": "kMandarin 是面向排序和转写的信息性常用拼音属性；一个值适用于 CN/TW，两值按 CN（zh-Hans）、TW（zh-Hant）偏好顺序记录，并非完整多音字读音表。",
      "conditions": [
        "指定 UAX38_41 与 kMandarin，给定一或两个合成字符串；按 NFD 属性字符语法验证并保留原串及顺序，不查询字项。"
      ],
      "negative": "语法形状通过不等于合法音节、真实 Unihan 条目、语境读音、多音字或义项证明；两个值仅是地区偏好顺序。"
    },
    {
      "id": "H03.01.01.R1.C01",
