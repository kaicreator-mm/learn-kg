  "semantic_boundaries": {
    "composition": "specific versioned inputs and output types, assumptions/alternatives/negative boundaries, never infer qualification from input type alone; scope/subject/construct/measurement bindings checked",
    "evaluation": "comparison/intervention and estimand, followup, uncertainty, independent approval; no automatic training/promotion or actual learner data",
    "flow": "entry, explicit event transition, guard, priority, unknown/stop/pause terminal, bounded event/attempt budgets, checkpoints; parallel joins have explicit member IDs/mode/resume policy; definition only, runtime implementation/independent CQ later",
    "goal": "construct and success evidence required; standard membership not proof of capability",
    "knowledge_skill": "knowledge content and observable skill distinct; type-level reuse, not copy subject facts",
    "object": "part membership does not imply prerequisite; granularity and conditions explicit",
    "observation": "observation specification distinct from actual event, score, estimate, self-report; missing not zero, prompt/assistance and version matter",
    "policy": "advice only, no implicit state writes; distinct priority and bounded unknown fallback; budget/learner refusal cannot be overridden",
    "publication": "candidate research use only, rights HOLD and no release; immutable text manifest and typed receipt; no persistent SQLite",
    "resource": "modality not equivalence, rights and capability applicability checked; descriptions not content authority",
    "roles": "permission requirement is not actual permission; only downstream authorized execution may use it",
    "state": "state dimension is definition only; estimates require specific model/evidence/time/uncertainty; no individual data in package"
  },
