{
  "status": "ORIGINAL_SYNTHETIC_KNOWLEDGE_CASE_NOT_REAL_LEARNER_DATA",
  "policy": {
    "id": "R3-SHARED-RETRIEVAL-01",
    "version": "v1",
    "source_refs": [
      "R2-S02",
      "R2-S05"
    ],
    "purpose": "在已明确目标、初次教学和实际先备证据的条件下，先独立提取，失败后给最小有针对性反馈并渐撤，随后以新材料安排延迟复测。",
    "conditions": [
      "同目标构念与明确量规",
      "独立/辅助证据分离",
      "记录每次相关接触、练习与反馈时间",
      "学习者同意且资源可及",
      "策略参数是案例演示，不是普适建议"
    ],
    "decision_order": [
      "先确认任务与构念可用、角色归属和权限；缺失或歧义先澄清",
      "若目标组件新或独立证据不足，示范或区分性探查优先；若有独立正确基础且有保持目标，候选为无提示提取",
      "出现错误，保留原始响应，选择可区分假设的最短任务；反馈指向过程而非人格，最小提示后逐级减少",
      "延迟复测以最后一次相关接触结束时间计，记录完整性；题面未见且构念、量规、认知要求可比，独立作答",
      "保留错误和缺失；按当前表现、保持与情境迁移分别记录，不晋升掌握"
    ],
    "alternatives": [
      {
        "id": "WORKED_EXAMPLE",
        "when": "无先备证据或反复检索失败",
        "limits": "有答案不能作为独立表现"
      },
      {
        "id": "REREAD",
        "when": "恢复缺失信息或材料初见",
        "limits": "不替代独立提取；本案例不比较教育效果"
      },
      {
        "id": "RETRIEVAL",
        "when": "已经学过且有独立作答机会",
        "limits": "不是所有复杂技能的充分练习"
      },
      {
        "id": "DEFER",
        "when": "超预算、用户拒绝、缺材料或授权",
        "limits": "不将延期解释为低动机"
      }
    ],
    "min_delay_minutes": 1440,
    "delay_basis": "最后相关暴露结束时间（含教学、提示、复习、前次测验），本合成例24h，非经校准的阈值",
    "novelty_basis": "固定候选任务目录及显式暴露记录；family标签自身不足以证明未见。",
    "knowledge_outcome": "只允许任务得分与保持/迁移证据候选，实际教育效果和潜在掌握UNKNOWN",
    "claim_refs": [
      "K05.01.01.D4.01",
