      "priority": 10,
      "unknown_branch": "PAUSE",
      "failure_branch": "PAUSE",
      "budget": "REQUIRE_REMAINING_TURN_AND_TIME",
      "checkpoint": "RECORD_CANDIDATE_ONLY"
    },
    {
      "id": "T4",
      "from": "OBSERVE",
      "to": "FEEDBACK",
      "event": "OBSERVATION_RECORDED",
      "guard": "OBSERVATION_VALID",
      "priority": 10,
      "unknown_branch": "PAUSE",
      "failure_branch": "PAUSE",
      "budget": "REQUIRE_REMAINING_TURN_AND_TIME",
      "checkpoint": "RECORD_CANDIDATE_ONLY"
    },
    {
      "id": "T5",
      "from": "FEEDBACK",
      "to": "ADAPT",
      "event": "FEEDBACK_REVIEWED",
      "guard": "FEEDBACK_ALLOWED",
      "priority": 10,
      "unknown_branch": "PAUSE",
      "failure_branch": "PAUSE",
      "budget": "REQUIRE_REMAINING_TURN_AND_TIME",
      "checkpoint": "RECORD_CANDIDATE_ONLY"
    },
    {
      "id": "T6",
      "from": "ADAPT",
      "to": "ACTIVITY",
      "event": "RETRY",
      "guard": "RETRY_ELIGIBLE",
      "priority": 10,
      "unknown_branch": "PAUSE",
      "failure_branch": "PAUSE",
      "budget": "REQUIRE_REMAINING_TURN_AND_TIME",
      "checkpoint": "RECORD_CANDIDATE_ONLY"
    },
    {
      "id": "T7",
      "from": "ADAPT",
      "to": "RETENTION",
      "event": "SCHEDULE_RETEST",
      "guard": "RETEST_ELIGIBLE",
      "priority": 10,
      "unknown_branch": "PAUSE",
      "failure_branch": "PAUSE",
      "budget": "REQUIRE_REMAINING_TURN_AND_TIME",
      "checkpoint": "RECORD_CANDIDATE_ONLY"
    },
    {
      "id": "T8",
      "from": "ADAPT",
      "to": "END",
      "event": "FINISH",
      "guard": "COMPLETE",
      "priority": 10,
      "unknown_branch": "PAUSE",
      "failure_branch": "PAUSE",
      "budget": "REQUIRE_REMAINING_TURN_AND_TIME",
      "checkpoint": "RECORD_CANDIDATE_ONLY"
    },
    {
      "id": "T9",
      "from": "RETENTION",
      "to": "END",
      "event": "PLAN_RECORDED",
      "guard": "COMPLETE",
      "priority": 10,
      "unknown_branch": "PAUSE",
      "failure_branch": "PAUSE",
      "budget": "REQUIRE_REMAINING_TURN_AND_TIME",
      "checkpoint": "RECORD_CANDIDATE_ONLY"
    }
