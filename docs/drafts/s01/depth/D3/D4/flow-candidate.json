  "global_control": {
    "event": "VERIFIED_EXIT",
    "priority": 0,
    "target": "EXIT",
    "applies_to_nonterminal": true,
    "scope": "session/subject/global; verified control independent of ordinary learning-event time",
    "unknown": "PAUSE",
    "reference": "P10"
  },
  "optional_interventions": [
    {
      "guard": "MOTIVATION_OPT_IN",
      "contract": "P07",
      "effect": "OFFER_OPTIONAL_SUPPORT_ONLY",
      "may_change_mastery": false
