      }
    },
    {
      "stable_id": "example:flow:retrieve",
      "kind": "ProcessTemplate",
      "owner": "P06",
      "status": "DRAFT",
      "label": "回忆与反馈示例",
      "applies_to": {
        "package_id": "example.synthetic",
        "stable_id": "example:kind:symbol-meaning",
        "kind": "KnowledgeType",
        "version": "0.0.1"
      },
      "entry": "retrieve",
      "max_attempts": 2,
      "steps": [
        {
          "id": "retrieve",
          "activity": "请求独立回忆"
        },
        {
          "id": "feedback",
          "activity": "反馈并提供一次重试"
        },
        {
          "id": "complete",
          "terminal": true
        },
        {
          "id": "stop",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "from": "retrieve",
          "event": "correct_independent",
          "to": "complete"
        },
        {
          "from": "retrieve",
          "event": "incorrect",
          "guard": {
            "attempts_lt": 2
          },
          "to": "feedback"
        },
        {
          "from": "retrieve",
          "event": "incorrect",
          "guard": {
            "attempts_gte": 2
          },
          "to": "stop"
        },
        {
          "from": "retrieve",
          "event": "unknown",
          "to": "stop"
        },
        {
          "from": "feedback",
          "event": "retry_requested",
          "to": "retrieve",
          "increment_attempts": 1
        },
        {
          "from": "feedback",
          "event": "exit_requested",
          "to": "stop"
        }
      ],
      "evidence_refs": [],
      "qualification": "NOT_RUN"
    }
  ]
}
