    },
    {
      "stable_id": "example:object:token-a",
      "kind": "LearningObject",
      "owner": "H03",
      "status": "DRAFT",
      "label": "示例词A",
      "knowledge_type": {
        "package_id": "example.synthetic",
        "stable_id": "example:kind:symbol-meaning",
        "kind": "KnowledgeType",
