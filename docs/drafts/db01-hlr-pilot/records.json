          "name": "estimate_half_life",
          "expr": {
            "op": "pow2",
            "args": [
              {
                "op": "dot",
                "args": [
                  {
                    "var": "weights"
                  },
                  {
                    "var": "features"
                  }
                ]
              }
            ]
          }
        },
        {
          "name": "inverse_half_life",
          "expr": {
            "op": "neg",
            "args": [
              {
                "op": "div",
                "args": [
                  {
                    "var": "delta"
                  },
                  {
                    "op": "log2",
                    "args": [
                      {
                        "var": "p"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "conditions": [
        "time unit day in pilot",
        "finite positive half-life",
        "no intermediate practice between last event and prediction",
        "feature and weight dimensions agree"
      ],
      "limits": [
        "finite binary64 implementation; numeric overflow/underflow rejected",
        "no fitting, actual learner or deployment"
      ]
