    {
      "stable_id": "hlr:claim:inverse",
      "kind": "Claim",
      "owner": "K10",
      "status": "DRAFT",
      "topic": "K10.03.02",
      "claim_type": "MATHEMATICAL_MODEL",
      "statement": "由指数方程可逆求半衰期h=-d/log2(p)，仅在d>0且0<p<1时得到有限正值。",
      "conditions": [
        "同一模型、正时距、概率严格介于0与1"
      ],
      "limitations": [
        "样本正确率代入是估计而非直接测得半衰期",
        "端点或零时距不作有限正值估计"
      ],
      "evidence_refs": [
        {
