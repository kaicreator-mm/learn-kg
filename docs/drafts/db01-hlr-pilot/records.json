      "claim_type": "MATHEMATICAL_MODEL",
      "statement": "HLR以特征向量和拟合权重的内积作为2的指数来估计半衰期。",
      "conditions": [
        "特征、权重、单位和模型版本匹配"
      ],
      "limitations": [
        "权重需实际拟合与评估，不提供通用默认值"
      ],
      "evidence_refs": [
