    {
      "stable_id": "hlr:claim:curve",
      "kind": "Claim",
      "owner": "K10",
      "status": "DRAFT",
      "topic": "K10.03.01",
      "claim_type": "MATHEMATICAL_MODEL",
      "statement": "固定半衰期h时，回忆概率预测为2的负时距与半衰期比值次幂。",
      "conditions": [
        "时距非负、半衰期有限且为正",
        "时间单位一致、给定同一对象与模型"
      ],
      "limitations": [
        "零时距预测1是模型假设，不是实测保证",
        "不是所有记忆均满足指数模型"
      ],
      "evidence_refs": [
        {
          "package_id": "learn-kg.draft.unified.hlr",
          "version": "0.0.2",
          "stable_id": "hlr:locator:curve",
