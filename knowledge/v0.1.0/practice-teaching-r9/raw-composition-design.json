    {
      "id": "K05.PT.COMP.01",
      "mode": "compare",
      "boundary": "Both observations use same target, material, opportunities, delay, assessment format and independent conditions. Distinct practice strategies. Bounded selection is descriptive, not causal; no comparison if required fields invalid or unequal.",
      "base": {
        "a": {
          "target": "recall",
          "material": "set1",
          "opportunities": 4,
          "delay_days": 7,
          "format": "free_recall",
          "independent": true,
          "strategy": "restudy",
          "correct": 4,
          "total": 10
        },
        "b": {
          "target": "recall",
          "material": "set1",
          "opportunities": 4,
          "delay_days": 7,
          "format": "free_recall",
          "independent": true,
          "strategy": "retrieval",
          "correct": 7,
          "total": 10
        }
      },
      "cases": [
        {
          "name": "matched",
          "patch": {},
          "expected": {
            "action": "SUGGEST",
            "reason": "MATCHED_DESCRIPTIVE_COMPARISON",
            "preferred": "retrieval"
          }
        },
        {
          "name": "tie",
          "patch": {
            "b.correct": 4
          },
          "expected": {
            "action": "CLARIFY",
            "reason": "NO_OBSERVED_ADVANTAGE"
          }
        },
        {
          "name": "immediate_vs_delay",
          "patch": {
            "b.delay_days": 0
          },
          "expected": {
            "action": "CLARIFY",
            "reason": "UNMATCHED"
          }
        },
        {
          "name": "assisted",
          "patch": {
            "b.independent": false
          },
          "expected": {
            "action": "CLARIFY",
            "reason": "UNMATCHED"
          }
        },
        {
          "name": "missing_score",
          "patch": {
            "b.correct": null
          },
          "expected": {
            "action": "CLARIFY",
            "reason": "INVALID_OBSERVATION"
          }
        },
        {
          "name": "wrong_count_type",
          "patch": {
            "b.correct": true
          },
          "expected": {
            "action": "CLARIFY",
            "reason": "INVALID_OBSERVATION"
          }
        },
        {
          "name": "different_denominator",
          "patch": {
            "b.total": 20
          },
          "expected": {
            "action": "CLARIFY",
            "reason": "UNMATCHED"
          }
        },
        {
          "name": "same_strategy",
          "patch": {
            "b.strategy": "restudy"
          },
          "expected": {
            "action": "CLARIFY",
            "reason": "UNMATCHED"
          }
        },
        {
          "name": "zero_opportunities",
          "patch": {
            "a.opportunities": 0,
            "b.opportunities": 0
          },
          "expected": {
            "action": "CLARIFY",
            "reason": "INVALID_OBSERVATION"
          }
        },
        {
          "name": "reverse",
          "patch": {
            "a.correct": 9
          },
          "expected": {
            "action": "SUGGEST",
            "reason": "MATCHED_DESCRIPTIVE_COMPARISON",
            "preferred": "restudy"
          }
        }
      ]
    },
